{
  "name": "slipstream",
  "version": "1.0.6",
  "description": "A privacy-first macOS assistant that turns consequential English into source-backed actions.",
  "author": "Slipstream",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0boluan0/Slipstream.git"
  },
  "homepage": "https://github.com/0boluan0/Slipstream#readme",
  "bugs": {
    "url": "https://github.com/0boluan0/Slipstream/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.7.0",
  "main": "src/main/main.js",
  "overrides": {
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "undici@>=7 <8": "7.29.0"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"electron . --dev\"",
    "dev:ui-fixture": "node scripts/run-ui-fixture.js",
    "build": "vite build && npm run check:renderer-lazy-artifacts && node scripts/build-macos.js",
    "build:signed": "vite build && npm run check:renderer-lazy-artifacts && node scripts/build-macos.js --signed",
    "release:unsigned": "npm run build && npm run release:checksums && npm run check:release",
    "release:signed": "npm run check:signing && npm run check:notarization-env && npm run build:signed && npm run release:checksums && npm run check:release && npm run check:distribution",
    "start": "electron .",
    "build:renderer": "vite build && npm run check:renderer-lazy-artifacts",
    "measure:renderer-startup": "node scripts/measure-renderer-startup.mjs",
    "measure:renderer-startup:smoke": "node scripts/measure-renderer-startup.mjs --smoke",
    "capture:startup-evidence": "node scripts/capture-startup-evidence.mjs",
    "lint": "eslint src preload.js scripts --ext .js,.jsx,.mjs,.cjs",
    "check:core": "node scripts/check-core-regressions.js",
    "check:electron-ui-fixture": "node scripts/check-electron-ui-fixture.js",
    "check:electron-ui-fixture-runtime": "node scripts/check-electron-ui-fixture-runtime.js",
    "check:startup-benchmark-mode": "node scripts/check-startup-benchmark-mode.js",
    "check:renderer-startup-harness": "node scripts/check-renderer-startup-harness.mjs",
    "check:startup-evidence-harness": "node scripts/check-startup-evidence-harness.mjs",
    "check:startup-evidence-harness:runtime": "node scripts/check-startup-evidence-harness.mjs --runtime",
    "check:startup-first-interaction": "node scripts/check-startup-first-interaction.mjs",
    "check:capture-ingress-readiness": "node scripts/check-capture-ingress-readiness.mjs",
    "check:first-run": "node scripts/check-first-run-readiness.js",
    "check:renderer-icons": "node scripts/check-renderer-icon-imports.mjs",
    "check:renderer-ipc-boundary": "node scripts/check-renderer-ipc-boundary.mjs",
    "check:renderer-lazy-boundaries": "node scripts/check-renderer-lazy-boundaries.mjs",
    "check:renderer-lazy-artifacts": "node scripts/check-renderer-lazy-artifacts.mjs",
    "check:renderer-lazy-file-runtime": "node scripts/check-workspace-module-retry-runtime.js",
    "check:saved-terms-deferral-runtime": "npm run build:renderer && node scripts/check-saved-terms-deferral-runtime.js",
    "check:result-stylesheet-deferral-runtime": "node scripts/check-result-stylesheet-deferral-runtime.js",
    "check:endpoint-boundary": "node scripts/check-custom-endpoint-boundary.js",
    "check:endpoint-location": "node scripts/check-endpoint-location.mjs",
    "check:endpoint-validation-invariant": "node scripts/check-endpoint-validation-invariant.mjs",
    "check:custom-analysis-boundary": "node scripts/check-custom-analysis-boundary.js",
    "check:ollama-analysis-boundary": "node scripts/check-ollama-analysis-boundary.js",
    "check:shortcut-readiness": "node scripts/check-shortcut-readiness.mjs",
    "check:processing-recovery": "node scripts/check-processing-recovery.mjs",
    "check:translation-fallback": "node scripts/check-translation-fallback.mjs",
    "check:credential-exit": "node scripts/check-credential-exit.mjs",
    "check:credential-removal-dialog": "node scripts/check-credential-removal-dialog.mjs",
    "check:settings-transition-dialog": "node scripts/check-settings-transition-dialog.mjs",
    "check:settings-accessibility": "node scripts/check-settings-accessibility.mjs",
    "check:screen-reader-semantics": "node scripts/check-screen-reader-semantics.mjs && node scripts/check-screen-reader-semantics-runtime.js",
    "check:reduced-motion": "node scripts/check-reduced-motion.mjs && node scripts/check-reduced-motion-runtime.js",
    "check:contrast-preferences": "node scripts/check-contrast-preferences.mjs && node scripts/check-contrast-preferences-runtime.js",
    "check:credential-visibility": "node scripts/check-credential-visibility.mjs",
    "check:deepseek-live": "node scripts/check-deepseek-live.js",
    "check:deepseek-quality-live": "node scripts/check-deepseek-quality-live.js",
    "check:provider-connection": "node scripts/check-provider-connection.js",
    "check:user-errors": "node scripts/check-user-facing-errors.js",
    "check:redaction": "node scripts/check-settings-redaction.js",
    "check:prompts": "node scripts/check-prompt-templates.js",
    "check:model-quality-benchmark": "node scripts/check-model-quality-benchmark.js",
    "check:long-text": "node scripts/check-long-text-chunking.js && node scripts/check-long-text-flow.js",
    "check:screenshot-shortcut": "node scripts/check-screenshot-shortcut.js && node scripts/check-screenshot-overlay.js",
    "check:capture-integrity": "node scripts/check-capture-integrity.js",
    "check:ocr-environment": "node scripts/check-ocr-environment.js",
    "check:ocr-runtime": "node scripts/check-vision-ocr-runtime.js",
    "check:ocr-review": "node scripts/check-ocr-review.mjs && node scripts/check-ocr-review-gate.mjs",
    "check:ocr-languages": "node scripts/check-ocr-languages.js",
    "check:truncation": "node scripts/check-truncation-warning.js",
    "check:progress-feedback": "node scripts/check-truthful-progress.js",
    "check:action-brief": "node scripts/check-action-brief.js",
    "check:action-dependencies": "node scripts/check-action-dependencies.mjs",
    "check:reply-progress-consistency": "node scripts/check-reply-progress-consistency.mjs",
    "check:action-brief-service": "node scripts/check-action-brief-service.js",
    "check:renderer-evidence": "node scripts/check-renderer-evidence.mjs && node scripts/check-result-integrity.mjs",
    "check:deadline-urgency": "node scripts/check-deadline-urgency.mjs",
    "check:action-progress": "node scripts/check-action-progress.mjs",
    "check:task-closure": "node scripts/check-task-closure.mjs",
    "check:verification-approval": "node scripts/check-verification-approval.js",
    "check:verification": "node scripts/check-verification-security.js && node scripts/check-verification-discovery.js && npm run check:verification-approval",
    "check:storage-startup": "node scripts/check-storage-startup.js",
    "check:storage-privacy": "node scripts/check-storage-privacy.js",
    "check:term-transfer": "node scripts/check-term-transfer.js",
    "check:saved-term-trust": "node scripts/check-saved-term-trust.mjs",
    "check:saved-term-removal": "node scripts/check-saved-term-removal.mjs",
    "check:build-identity": "node scripts/check-build-identity.js",
    "check:file-provider-conflicts": "node scripts/check-file-provider-conflicts.js",
    "check:support-diagnostics": "node scripts/check-support-diagnostics.js",
    "check:auto-update": "node scripts/check-auto-update.js",
    "check:settings-load-recovery": "node scripts/check-settings-load-recovery.mjs",
    "check:full-data-reset": "node scripts/check-full-data-reset.mjs",
    "check:clear-undo": "node scripts/check-clear-undo.mjs",
    "check:manual-clipboard-read": "node scripts/check-manual-clipboard-read.mjs",
    "check:session-recovery": "node scripts/check-session-recovery.mjs",
    "check:background-task-status": "node scripts/check-background-task-status.js",
    "check:background-task-handoff": "node scripts/check-background-task-handoff.js",
    "check:task-cancellation": "node scripts/check-task-cancellation.js",
    "check:quit-safety": "node scripts/check-quit-safety.mjs",
    "check:settings-menu": "node scripts/check-settings-request-registry.js && node scripts/check-settings-menu.mjs",
    "check:modal-ownership": "node scripts/check-modal-ownership.mjs",
    "check:settings-reset-dialog": "node scripts/check-settings-reset-dialog.mjs",
    "check:clipboard-quit-safety": "node scripts/check-clipboard-quit-safety.mjs",
    "check:clipboard-monitor-consent": "node scripts/check-clipboard-monitor-consent.mjs",
    "check:clipboard-monitor-visibility": "node scripts/check-clipboard-monitor-visibility.mjs",
    "check:clipboard-monitor-collisions": "node scripts/check-clipboard-monitor-collisions.mjs",
    "check:active-capture-collisions": "node scripts/check-active-capture-collisions.mjs",
    "check:foreground-capture-guard": "node scripts/check-foreground-capture-guard.mjs",
    "check:guided-reply-capture-ownership": "node scripts/check-guided-reply-capture-ownership.mjs",
    "check:settings-capture-guard": "node scripts/check-settings-capture-guard.mjs",
    "check:first-use-capture-intent": "node scripts/check-first-use-capture-intent.mjs",
    "check:clipboard-privacy": "node scripts/check-clipboard-privacy.mjs",
    "check:clipboard-residue-risk": "node scripts/check-clipboard-residue-risk.mjs",
    "check:reply-clipboard-lifecycle": "node scripts/check-reply-clipboard-lifecycle.mjs",
    "check:clipboard-exit-privacy": "node scripts/check-clipboard-exit-privacy.mjs",
    "check:source-actions": "node scripts/check-source-actions.mjs",
    "check:history": "node scripts/run-history-check.js",
    "check:package-config": "node scripts/check-package-config.js",
    "check:dev-dependency-security": "node scripts/check-dev-dependency-security.js",
    "check:runtime-dependencies": "npm audit --omit=dev --audit-level=high",
    "check:release-info": "node scripts/check-release-info.js",
    "check:release-artifacts": "node scripts/check-release-artifacts.js",
    "check:release-manifest": "node scripts/check-release-artifacts.js --manifest-only",
    "check:macos-metadata": "node scripts/check-macos-metadata.js",
    "test": "npm run check:core && npm run check:electron-ui-fixture && npm run check:electron-ui-fixture-runtime && npm run check:startup-benchmark-mode && npm run check:renderer-startup-harness && npm run check:startup-evidence-harness && npm run check:startup-first-interaction && npm run check:capture-ingress-readiness && npm run check:first-run && npm run check:renderer-icons && npm run check:renderer-ipc-boundary && npm run check:renderer-lazy-boundaries && npm run check:renderer-lazy-file-runtime && npm run check:saved-terms-deferral-runtime && npm run check:result-stylesheet-deferral-runtime && npm run check:endpoint-boundary && npm run check:endpoint-location && npm run check:endpoint-validation-invariant && npm run check:custom-analysis-boundary && npm run check:ollama-analysis-boundary && npm run check:shortcut-readiness && npm run check:processing-recovery && npm run check:translation-fallback && npm run check:credential-exit && npm run check:credential-removal-dialog && npm run check:settings-transition-dialog && npm run check:settings-accessibility && npm run check:screen-reader-semantics && npm run check:reduced-motion && npm run check:contrast-preferences && npm run check:credential-visibility && npm run check:settings-load-recovery && npm run check:full-data-reset && npm run check:clear-undo && npm run check:manual-clipboard-read && npm run check:session-recovery && npm run check:action-progress && npm run check:task-closure && npm run check:background-task-status && npm run check:background-task-handoff && npm run check:task-cancellation && npm run check:quit-safety && npm run check:settings-menu && npm run check:modal-ownership && npm run check:settings-reset-dialog && npm run check:clipboard-quit-safety && npm run check:clipboard-monitor-consent && npm run check:clipboard-monitor-visibility && npm run check:clipboard-monitor-collisions && npm run check:active-capture-collisions && npm run check:foreground-capture-guard && npm run check:guided-reply-capture-ownership && npm run check:settings-capture-guard && npm run check:first-use-capture-intent && npm run check:clipboard-privacy && npm run check:clipboard-residue-risk && npm run check:reply-clipboard-lifecycle && npm run check:clipboard-exit-privacy && npm run check:source-actions && npm run check:provider-connection && npm run check:user-errors && npm run check:capture-integrity && npm run check:ocr-environment && npm run check:ocr-runtime && npm run check:ocr-review && npm run check:action-brief && npm run check:action-dependencies && npm run check:reply-progress-consistency && npm run check:action-brief-service && npm run check:renderer-evidence && npm run check:deadline-urgency && npm run check:action-progress && npm run check:task-closure && npm run check:verification && npm run check:storage-startup && npm run check:storage-privacy && npm run check:term-transfer && npm run check:saved-term-trust && npm run check:saved-term-removal && npm run check:build-identity && npm run check:file-provider-conflicts && npm run check:support-diagnostics && npm run check:auto-update && npm run check:redaction && npm run check:prompts && npm run check:model-quality-benchmark && npm run check:long-text && npm run check:screenshot-shortcut && npm run check:ocr-languages && npm run check:truncation && npm run check:progress-feedback && npm run check:macos-metadata && npm run check:dev-dependency-security",
    "check:release": "npm run check:package-config && npm run check:runtime-dependencies && npm run check:release-info && npm run check:release-artifacts && npm test && npm run lint && npm run check:history && npm run check:release-manifest",
    "check:signing": "node scripts/check-signing-readiness.js",
    "check:notarization-env": "node scripts/check-notarization-env.js",
    "check:distribution": "node scripts/check-distribution-trust.js",
    "diagnose:screen-permission": "electron scripts/check-screen-permission-runtime.js",
    "release:checksums": "node scripts/write-release-checksums.js",
    "format": "prettier --write 'src/**/*.{js,jsx,css,html}'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "electron-store": "^8.1.0",
    "electron-updater": "6.8.9",
    "openai": "^4.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "com.slipstream.app",
    "productName": "Slipstream",
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.js",
    "afterSign": "scripts/after-sign.js",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "files": [
      "dist/renderer/**/*",
      "src/main/**/*",
      "!src/main/ui-fixture-mode.js",
      "src/shared/**/*",
      "assets/menubar-template.png",
      "assets/menubar-template@2x.png",
      "LICENSE",
      "README.md",
      "preload.js",
      "package.json",
      "!**/* +([0-9]).+([^.])",
      "!**/* +([0-9]){,/**/*}"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "VisionOCR.swift",
          "ocr-swift-runner.sh"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "12.0",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "signIgnore": "\\.pak$",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Slipstream 仅在你主动框选时读取该屏幕区域，并在本机完成截图与文字识别。 Slipstream only captures the region you select and runs OCR locally."
      },
      "notarize": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "writeUpdateInfo": false,
      "title": "Install Slipstream",
      "background": "dmg-background.png",
      "iconSize": 128,
      "iconTextSize": 12,
      "contents": [
        {
          "x": 170,
          "y": 215,
          "type": "file"
        },
        {
          "x": 490,
          "y": 215,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "0boluan0",
      "repo": "Slipstream"
    }
  },
  "devDependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^8.2.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.50.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "js-yaml": "4.3.1",
    "prettier": "^3.1.0",
    "vite": "^8.1.4"
  }
}
